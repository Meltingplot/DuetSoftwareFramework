#!/bin/sh

# Create gpio group and add dsf to it
systemd-sysusers duetcontrolserver.conf

# Ensure dsf group memberships on upgrade. systemd-sysusers "m" lines are unreliable for
# pre-existing users on older systemd versions, so re-apply explicitly
for grp in gpio video dialout; do
    getent group "$grp" >/dev/null 2>&1 && usermod -a -G "$grp" dsf || true
done

# Create /var/run/dsf now
systemd-tmpfiles --create duetcontrolserver.conf

# Trigger assignment of gpio group to the existing devices, but only when udev is running
[ -d /run/udev ] && udevadm trigger || true

# Set ownership and permissions. The configuration directory and the plugin directory belong to root, the dsf group may create entries in them,
# and the sticky bit lets dsf remove or rename only the entries it owns. So dsf can neither change nor replace the files of root in them: the
# settings from which the root plugin service runs commands (plugins.json and apparmor.conf, see the duetpluginservice postinst) and the files
# of root plugins. The owner of a sticky directory may remove any entry, so neither directory may belong to dsf. The root plugin service refuses
# root plugins unless the plugin directory is set up like this
chown root:dsf /opt/dsf/conf /opt/dsf/plugins
chmod 1775 /opt/dsf/conf /opt/dsf/plugins

# DCS writes its settings and the list of plugins to start. chown -h changes a symlink itself instead of its target. chmod would follow one, and
# dsf may replace a file of its own by one at any time, so the file belongs to root while chmod checks and changes it
for file in /opt/dsf/conf/config.json /opt/dsf/conf/plugins.txt; do
    if [ -e "$file" ] || [ -L "$file" ]; then
        chown -h root:root "$file"
        [ -L "$file" ] || chmod g+w "$file"
        chown -h dsf:dsf "$file"
    fi
done

# File capabilities trigger AT_SECURE=1 on exec, which DCS verifies when DCS connects back
# to itself (e.g. `DuetControlServer -u`) to defend against LD_PRELOAD masquerade attacks.
# DCS needs the capabilities only to read /proc/<pid>/exe and auxv of the DSF services that
# connect to it, and raises them for these reads alone. So they are permitted but not
# effective (no "e"), and every other file DCS opens is opened with the rights of dsf.
# The IPC handshake rejects peers without AT_SECURE, so a failed setcap must not be silently
# ignored - warn loudly because DSF services will refuse to talk to each other otherwise
if ! setcap cap_sys_ptrace,cap_dac_read_search+p /opt/dsf/bin/DuetControlServer; then
    echo "WARNING: failed to set file capabilities on DuetControlServer" >&2
    echo "         DSF services will refuse IPC connections until file capabilities can be set" >&2
    echo "         (check that /opt is on a filesystem supporting capabilities and not mounted nosuid)" >&2
fi

# Update systemd services, but only when systemd is the running init (skips build chroots/containers)
if [ -d /run/systemd/system ]; then
    systemctl -q --no-ask-password daemon-reload

    # Start DCS again if it is enabled via systemd
    if systemctl -q is-enabled duetcontrolserver; then
        systemctl -q --no-ask-password --no-block start duetcontrolserver || true
    fi
fi

# Ignore the return code of the DCS start request in case no board is connected
exit 0
