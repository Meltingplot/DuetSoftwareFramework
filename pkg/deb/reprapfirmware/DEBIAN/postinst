#!/bin/sh

# DWS (rr_upload) and DCS (M28, echo, files written by RRF) overwrite files in place, so the firmware files that dpkg installs as root must belong to dsf.
# dsf owns /opt/dsf/sd and may put a symlink in place of any entry below it, a directory too, so root does nothing there. Instead dsf copies each firmware
# file of this package and puts the copy in its place, with its own rights
dpkg-query -L reprapfirmware | while read -r file; do
	case "$file" in
		/opt/dsf/sd/*.bin|/opt/dsf/sd/*.uf2)
			setpriv --reuid=dsf --regid=dsf --clear-groups -- cp "$file" "$file.new" &&
				setpriv --reuid=dsf --regid=dsf --clear-groups -- mv -f "$file.new" "$file"
			;;
	esac
done

# Instruct DuetControlServer to update the firmware.
# Do this only if GPIO and SPI nodes are available in SysFS
if [ -e /opt/dsf/bin/DuetControlServer ] && [ -d /sys/class/gpio ] && [ -d /sys/module/spidev ]; then
	# Wait a few extra seconds to let DCS start after an update. This may be needed when running on slow SD cards
	sleep 5
	/opt/dsf/bin/DuetControlServer -u
else
	echo "Skipping RepRapFirmware auto-update because no DCS, GPIO and/or SPI devices could be detected"
fi
exit 0
