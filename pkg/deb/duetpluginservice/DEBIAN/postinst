#!/bin/sh

# Set ownership and permissions. The root service runs the Python installer for root plugins, so the dsf user must not be able to change it
chown -R dsf:dsf /opt/dsf/conf/plugins*
chown root:root /opt/dsf/bin/pipInstall2.py
chmod 755 /opt/dsf/bin/pipInstall2.py

# The plugin directory belongs to root, the dsf group may create entries and the sticky bit lets dsf remove or rename only its own entries,
# like the duetcontrolserver package sets it up
chown root:dsf /opt/dsf/plugins
chmod 1775 /opt/dsf/plugins

# Drop existing per-plugin AppArmor profiles so DPS regenerates them from the current template on its next start
rm -f /etc/apparmor.d/dsf.*

# Update systemd services, but only when systemd is the running init (skips build chroots/containers)
if [ -d /run/systemd/system ]; then
    # Re-apply the [Install] section of enabled DPS instances so that upgrades pick up new WantedBy= entries
    for unit in duetpluginservice duetpluginservice-root; do
        if systemctl -q is-enabled $unit; then
            systemctl -q --no-reload reenable $unit || true
        fi
    done

    systemctl -q --no-ask-password daemon-reload

    # Start DPS instances again if they are enabled via systemd
    if systemctl -q is-enabled duetpluginservice; then
        systemctl -q --no-ask-password --no-block start duetpluginservice || true
    fi

    if systemctl -q is-enabled duetpluginservice-root; then
        systemctl -q --no-ask-password --no-block start duetpluginservice-root || true
    fi
fi

# Don't block the configuration of other packages if DPS failed to start
exit 0
