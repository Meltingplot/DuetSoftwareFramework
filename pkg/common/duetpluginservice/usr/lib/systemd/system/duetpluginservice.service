[Unit]
Description=Duet Plugin Service
PartOf=duetcontrolserver.service
After=duetcontrolserver.service multi-user.target
StartLimitIntervalSec=0

[Service]
ExecStart=/opt/dsf/bin/DuetPluginService
WorkingDirectory=/opt/dsf/bin
TimeoutStopSec=15
Restart=always
Type=notify
User=dsf
Group=dsf
UMask=0002
KillMode=control-group
SendSIGKILL=yes

[Install]
# Start together with DCS too, so that DPS comes back when DCS is stopped and started again
WantedBy=multi-user.target duetcontrolserver.service
